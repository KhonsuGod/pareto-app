# Salin file ini menjadi .env lalu isi sesuai kebutuhan.

# Sheet admin Proses 2 (ikon Share di Google Sheet -> Copy link):
ADMIN_SHEET_URL=https://docs.google.com/spreadsheets/d/ISI_ID_SPREADSHEET_ANDA/edit

# Atau langsung ID spreadsheetnya:
ADMIN_SPREADSHEET_ID=

# Sheet admin Proses 1 (opsional - kalau kosong dipakai ID di config.yaml):
ADMIN_SHEET_URL_PROSES1=
ADMIN_SPREADSHEET_ID_PROSES1=

# Opsional: service account JSON (bila fetcher = gspread)
GOOGLE_CREDENTIALS_FILE=
