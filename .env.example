# Salin file ini jadi .env, isi link sheet admin tiap proses.
# Cara isi: buka Google Sheet -> Share -> Copy link, paste ke bawah.
# Baris yang tidak dipakai biarkan kosong.

# Proses 2:
ADMIN_SHEET_URL=
ADMIN_SPREADSHEET_ID=

# Proses 1:
ADMIN_SHEET_URL_PROSES1=
ADMIN_SPREADSHEET_ID_PROSES1=

# Opsional (bila google.fetcher = gspread di config.yaml):
GOOGLE_CREDENTIALS_FILE=
